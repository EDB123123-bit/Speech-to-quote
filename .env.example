# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public production URL, without a trailing slash. OAuth callback URLs are
# derived from this value (for example https://quotes.example.com).
APP_URL=

# Gmail send-only OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook / Microsoft 365 send-only OAuth
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common

# AI providers (server-only — never expose to the browser)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model selection
EXTRACTION_MODEL=claude-sonnet-5
TRANSCRIPTION_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Protects the audio-cleanup cron route
CRON_SECRET=
